{
    "name": "@everyonesoftware/cli",
    "version": "11.0.0",
    "description": "The CLI for everyonesoftware.",
    "repository": {
        "url": "git+https://github.com/everyonesoftware/cli-typescript.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "everyonesoftware",
    "license": "ISC",
    "type": "module",
    "main": "outputs/sources/main.js",
    "types": "outputs/sources/main.d.ts",
    "bin": {
        "e1": "outputs/sources/main.js",
        "everyone": "outputs/sources/main.js"
    },
    "files": [
        "outputs/sources",
        "CHANGELOG.md",
        "LICENSE.md",
        "package.json",
        "README.md"
    ],
    "dependencies": {
        "@everyonesoftware/common": "58.0.0",
        "ts-morph": "^28.0.0"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.2",
        "@types/node": "^24.0.0",
        "c8": "^11.0.0",
        "oxlint": "^1.75.0",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "build": "npm run lint && e1 fix-imports && npx tsc",
        "lint": "npx oxlint",
        "test-only": "c8 node -r source-map-support/register outputs/tests/tests.js",
        "test": "npm run build && npm run test-only"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
